# Reference only. Generate real secrets with: python3 scripts/setup_domains.py
COMPOSE_PROJECT_NAME=accord-niche
DOMAIN_ONLY=true
PUBLIC_URL=https://shop.accordniche.pp.ua
DASHBOARD_PUBLIC_URL=https://dashboard.accordniche.pp.ua
TRUSTED_HOSTS=accordniche.pp.ua,shop.accordniche.pp.ua,dashboard.accordniche.pp.ua,localhost,127.0.0.1
CORS_ORIGINS=https://dashboard.accordniche.pp.ua
MAIN_DOMAIN_ALIASES=
ENABLE_API_DOCS=false
POSTGRES_USER=accord
POSTGRES_DB=accord
POSTGRES_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
REDIS_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
REDIS_URL=GENERATE_WITH_SETUP_SCRIPT
JWT_SECRET=GENERATE_WITH_SETUP_SCRIPT
DATA_ENCRYPTION_KEY=GENERATE_WITH_SETUP_SCRIPT
DASHBOARD_LOGIN=accordadmin
DASHBOARD_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
JWT_TTL_HOURS=8
DASHBOARD_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
WEBHOOK_SECRET=GENERATE_WITH_SETUP_SCRIPT
CRON_SECRET=GENERATE_WITH_SETUP_SCRIPT
OPTIONAL_TELEGRAM=true
SHOP_NAME=ACCORD NICHE
BOT_TOKEN=
BOT_USERNAME=
ADMIN_CHAT_ID=0
ADMIN_IDS=
ACCORD_MINIAPP_URL=
MINIAPP_SHORT_NAME=
ACCORD_GOOGLE_CLIENT_ID=
ACCORD_GOOGLE_SITE_VERIFICATION=
# ACCORD Android app: OAuth client ID(s) of type Android (Google Cloud console,
# same project as ACCORD_GOOGLE_CLIENT_ID), comma separated. Google sign-in in
# the app is refused until set. Package and SHA-256 of the signing certificate
# publish /.well-known/assetlinks.json so site links open in the app.
ACCORD_GOOGLE_ANDROID_CLIENT_IDS=
ACCORD_ANDROID_PACKAGE=ua.accordniche.shop
ACCORD_ANDROID_CERT_SHA256=
# Optional SMS codes through your own Android phone (SMS Gateway for Android).
# Phone confirmation through the Telegram bot needs only BOT_TOKEN/BOT_USERNAME.
ACCORD_SMS_GATEWAY_URL=
ACCORD_SMS_GATEWAY_LOGIN=
ACCORD_SMS_GATEWAY_TOKEN=
ACCORD_INSTAGRAM_URL=
ACCORD_TIKTOK_URL=
ACCORD_TERMS_URL=
ACCORD_PRIVACY_URL=
ACCORD_PHONE=
SALESDRIVE_ENABLED=false
# CRM read watchdog: how often linked orders are refreshed in the background.
SALESDRIVE_BACKGROUND_REFRESH_SECONDS=180
AUTO_REPLIES_ENABLED=false
REFERRAL_ENABLED=false
LOG_JSON=1
# DEBUG | INFO | WARNING | ERROR. INFO is the safe production default.
LOG_LEVEL=INFO
ACCORD_SITE_PORT=18081
ACCORD_DASHBOARD_PORT=18082
ACCORD_MINIAPP_PORT=18083
