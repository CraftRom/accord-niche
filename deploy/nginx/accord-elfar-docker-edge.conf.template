# Sample additional server blocks inside ELFAR's Nginx container.
# Mount this into a directory included from the http context; connect
# ELFAR nginx to the external network accord-shared-edge. Only the three
# frontend services join this network; API and databases stay private.
# The ACCORD certificate must cover the root, shop and dashboard hostnames.
server {
    listen 80;
    include /etc/nginx/deny.d/*.conf;
    server_name accordniche.pp.ua shop.accordniche.pp.ua dashboard.accordniche.pp.ua;
    if ($host !~ ^(accordniche\.pp\.ua|shop\.accordniche\.pp\.ua|dashboard\.accordniche\.pp\.ua)$) { return 444; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 308 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    include /etc/nginx/deny.d/*.conf;
    server_tokens off;
    http2 on;
    server_name dashboard.accordniche.pp.ua;
    if ($host != dashboard.accordniche.pp.ua) { return 444; }
    ssl_certificate __ACCORD_CERT__;
    ssl_certificate_key __ACCORD_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    resolver 127.0.0.11 valid=10s ipv6=off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 2m;
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location = /api/media {
        client_max_body_size 9m;
        client_body_timeout 120s;
        set $upload_dashboard http://accord-dashboard:80;
        proxy_pass $upload_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection '';
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 180s;
    }
    location = /api/catalog/product-transfer/import {
        client_max_body_size 11m;
        client_body_timeout 120s;
        set $upload_dashboard http://accord-dashboard:80;
        proxy_pass $upload_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection '';
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 180s;
    }
    location = /api/backups/upload {
        client_max_body_size 65m;
        client_body_timeout 120s;
        set $upload_dashboard http://accord-dashboard:80;
        proxy_pass $upload_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection '';
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 180s;
    }
    location / {
        set $accord_dashboard http://accord-dashboard:80;
        proxy_pass $accord_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_read_timeout 370s;
    }
}
